# Copy this file to monitoring_agent/.env and fill in your own values.
# .env is gitignored; this example is safe to commit.

SENTINEL_DB_HOST=127.0.0.1
SENTINEL_DB_PORT=3306
SENTINEL_DB_NAME=sentinel_proc
SENTINEL_DB_USER=your_mysql_user
SENTINEL_DB_PASSWORD=your_mysql_password

# Optional. Enables VirusTotal reputation lookups. The free tier allows 4
# requests/minute and the scan pauses between hashes, so leave this unset
# unless you intend to spend real API quota.
# VT_API_KEY=your_virustotal_api_key
