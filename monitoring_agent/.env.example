# SentinelProc — Agent Environment Template
# Copy this file to monitoring_agent/.env and fill in your values.
# The .env file is gitignored and never committed.

# ── Transport ────────────────────────────────────────────────────────────────
# local  = write directly to MySQL + live_snapshot.json (single-laptop mode)
# api    = HTTPS API mode (remote laptops, no DB credentials needed)
SENTINEL_TRANSPORT=api

# ── Database (local mode only — leave unset for API mode) ────────────────────
# No defaults are provided; the agent fails loudly if these are missing.
SENTINEL_DB_HOST=127.0.0.1
SENTINEL_DB_PORT=3306
SENTINEL_DB_DATABASE=sentinel_proc
SENTINEL_DB_USERNAME=
# SENTINEL_DB_PASSWORD=            # leave empty if local MySQL has no password

# ── API mode (required when SENTINEL_TRANSPORT=api) ─────────────────────────
# The public HTTPS URL of the Laravel app (tunnel or domain).
SENTINEL_API_URL=https://your-tunnel-url.trycloudflare.com
# Token is shown once when minted. Paste it here and keep it secret.
SENTINEL_API_TOKEN=

# ── HTTP opt-in (hotspot fallback only) ─────────────────────────────────────
# Set to true ONLY on a trusted local network (e.g. your own phone hotspot).
# HTTP does not encrypt traffic or tokens — never use on public Wi-Fi.
# This does not disable certificate verification for HTTPS connections.
SENTINEL_ALLOW_HTTP=false

# ── VirusTotal (optional — leave unset to disable) ──────────────────────────
# API mode agents never query VirusTotal; the server provides cached results.
# VT_API_KEY=your-virustotal-api-key-here

# ── Scan tuning ─────────────────────────────────────────────────────────────
# Seconds between scans (default: 30)
# SENTINEL_SCAN_INTERVAL=30
# Seconds to wait between VirusTotal lookups to respect rate limits (default: 16)
# VT_RATE_LIMIT_SECONDS=16
# CPU sampling interval in seconds (default: 0.5)
# CPU_SAMPLE_INTERVAL=0.5

# ── Laravel app settings (for reference — set in sentinel_proc-web/.env) ─────
# APP_URL=http://127.0.0.1:8000
# APP_DEBUG=false
# TRUSTED_PROXIES=127.0.0.1,::1
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# AGENT_API_RATE_LIMIT_PER_TOKEN=60
# AGENT_API_RATE_LIMIT_PER_IP=120
