{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sentinelproc/sentinel-proc",
    "type": "project",
    "description": "SentinelProc — Real-Time Process Monitoring and Access Control System",
    "keywords": ["laravel", "monitoring", "security"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "sentinel_proc-web/app/",
            "Database\\Factories\\": "sentinel_proc-web/database/factories/",
            "Database\\Seeders\\": "sentinel_proc-web/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "sentinel_proc-web/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "cd sentinel_proc-web && php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "cd sentinel_proc-web && composer install --no-dev --optimize-autoloader"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
